 // MenuItem represents a menu item in the system tray (Linux stub).
 type MenuItem struct {
 	ClickedCh chan struct{}
@@ -126,13 +133,55 @@
 func (m *MenuItem) AddSeparator() {}
 
 // Run starts the system tray loop (Linux stub).
-func Run(onReadyFunc, onExitFunc func()) {}
+func Run(onReadyFunc, onExitFunc func()) {
+	runLoop(onReadyFunc, onExitFunc)
+}
 
 // RunHeadless starts the system tray loop without a status icon (Linux stub).
-func RunHeadless(onReadyFunc, onExitFunc func()) {}
+func RunHeadless(onReadyFunc, onExitFunc func()) {
+	runLoop(onReadyFunc, onExitFunc)
+}
 
 // Quit quits the application (Linux stub).
-func Quit() {}
+func Quit() {
+	runLoopLock.Lock()
+	state := activeRunLoop
+	runLoopLock.Unlock()
+
+	if state == nil {
+		return
+	}
+
+	state.once.Do(func() {
+		close(state.quit)
+	})
+}
+
+func runLoop(onReadyFunc, onExitFunc func()) {
+	state := &runLoopState{
+		quit: make(chan struct{}),
+	}
+
+	runLoopLock.Lock()
+	activeRunLoop = state
+	runLoopLock.Unlock()
+
+	if onReadyFunc != nil {
+		onReadyFunc()
+	}
+
+	<-state.quit
+
+	if onExitFunc != nil {
+		onExitFunc()
+	}
+
+	runLoopLock.Lock()
+	if activeRunLoop == state {
+		activeRunLoop = nil
+	}
+	runLoopLock.Unlock()
+}
 
